---
const { title, text, image, tags = [], actions = [], selectedPublications = [] } = Astro.props;
const visibleTags = tags.slice(0, 2);
---

<article class="theme-card">
  <span class="theme-card-image">
    <img src={image} alt="" loading="lazy" />
  </span>
  <div>
    <ul class="tags keyword-tags" aria-label="Keywords">
      {visibleTags.map((tag) => <li>{tag}</li>)}
    </ul>
    <h3>{title}</h3>
    <p class="theme-card-summary">{text}</p>
    {actions.length ? (
      <ul class="tool-links" aria-label="Tools and external links">
        {actions.map((action) => (
          <li><a href={action.link}>{action.label}</a></li>
        ))}
      </ul>
    ) : null}
  </div>
  {selectedPublications.length ? (
    <section class="selected-publications" aria-label={`Selected publications for ${title}`}>
      <h4>Selected publications</h4>
      <ul>
        {selectedPublications.map((publication) => (
          <li>
            <a href={publication.link}>{publication.title}</a>
            <span>{publication.authors}</span>
            <small>{publication.venue}</small>
          </li>
        ))}
      </ul>
    </section>
  ) : null}
</article>
